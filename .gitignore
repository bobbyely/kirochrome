# Node
node_modules/
dist/
build/
*.log
.npm/

# TypeScript incremental build state. Committing this makes `tsc -b` on a fresh
# clone believe the build is current, so it emits nothing and every workspace
# import fails.
*.tsbuildinfo

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# Env / secrets
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Worktrees an agent harness creates for itself. Only this path — project
# settings and agent definitions also live under .claude/ and are worth keeping.
.claude/worktrees/

# Local data
*.sqlite
*.sqlite3
data/
